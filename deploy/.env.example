# Hamroh backend configuration.
# Copy to .env and fill in real values. Never commit the filled file.

# ------------------------------------------------------------------ general
ENV=local                      # local | staging | production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
DEFAULT_LOCALE=uz
# Surfaced by /health so a deployment can be audited against the legal
# requirement that medical data stays inside Uzbekistan.
DATA_RESIDENCY_REGION=UZ

# ------------------------------------------------------------ service modes
# mock = simulate the provider's success locally, send nothing over the wire.
# real = call the provider's API with the credentials configured further down.
#
# Everything is "mock" today because the Click/Payme merchant, Eskiz/Play Mobile
# and Twilio applications have not been approved yet. Flip one variable at a
# time, as each set of credentials arrives; nothing else in the code changes.
#
# ENV=production REFUSES TO START while any of these is "mock".
SMS_MODE=mock                  # mock | real
IVR_MODE=mock                  # mock | real
PUSH_MODE=mock                 # mock | real
PAYMENT_MODE=mock              # mock | real
AI_MODE=mock                   # mock | real

# ----------------------------------------------------------------- database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=hamroh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hamroh

REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ storage
S3_ENDPOINT_URL=http://minio:9000
# Address the mobile app can reach for presigned downloads.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=hamroh-documents
S3_REGION=uz-1

# ---------------------------------------------------------------------- SMS
SMS_PROVIDER=console           # console | eskiz | playmobile
SMS_SENDER=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# Returns OTP codes in the API response instead of sending SMS.
# Ignored when ENV=production.
OTP_DEBUG_RETURN_CODE=true

# ---------------------------------------------------------------------- IVR
# Voice-call fallback when a dose is not confirmed in the app.
IVR_PROVIDER=console           # console | twilio
IVR_ENABLED=true
IVR_DELAY_MINUTES=18
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public base URL; the provider calls back here, so it must be reachable.
IVR_WEBHOOK_BASE_URL=https://api.hamroh.uz

# -------------------------------------------------------------------- OAuth
GOOGLE_CLIENT_IDS=            # comma separated: android,ios,web
TELEGRAM_BOT_TOKEN=

# --------------------------------------------------------------------- push
PUSH_PROVIDER=console          # console | fcm
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=          # service-account JSON, single line

# ----------------------------------------------------------------- payments
PLATFORM_FEE_PERCENT=20
CONSULTATION_SLA_HOURS=24
WALLET_MIN_PAYOUT_UZS=50000

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

DOCTOR_SUBSCRIPTION_MONTHLY_UZS=99000
DOCTOR_SUBSCRIPTION_YEARLY_UZS=990000
DOCTOR_SUBSCRIPTION_TRIAL_DAYS=14
DOCTOR_SUBSCRIPTION_ENFORCED=true

# ----------------------------------------------------------------------- AI
# console = answer with protocol text directly, no model call.
AI_PROVIDER=console            # console | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1000
AI_RAG_TOP_K=5
AI_MIN_RELEVANCE=0.12
AI_DAILY_MESSAGE_LIMIT=60

# ----------------------------------------------------------------- security
CORS_ORIGINS=*
TRUSTED_HOSTS=*
